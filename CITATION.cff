    affiliation: "3S Holding OÜ"
version: 0.1.0
date-released: "2026-11-13"
license: Apache-2.0
repository-code: "https://github.com/001shahab/scenelift"
keywords:
  - 3D reconstruction
  - computer vision
  - scene understanding
  - spatial reasoning
  - uncertainty
